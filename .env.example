# PostgreSQL connection (docker-compose.yml provides this user/db locally)
DATABASE_URL="postgresql://app:app@localhost:5432/my_app?schema=public"

# HTTP + WebSocket port (REST under /api, Hocuspocus under /collaboration)
PORT=3000

# Comma-separated list of allowed browser origins. Omit to allow any origin (demo).
# CORS_ORIGIN=http://localhost:5173,https://your-frontend.example.com
